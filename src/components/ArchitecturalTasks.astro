---
import { finishingStages } from '../data/finishing-stages';
import FinishingStageVisual from './FinishingStageVisual.astro';
---

<section class="finishing-system" id="selection" aria-labelledby="selection-title" data-finishing-system>
  <div class="finishing-system__container">
    <header class="finishing-system__intro" data-motion-reveal>
      <p class="finishing-system__eyebrow">02 / Система отделки / 5 этапов</p>
      <h2 id="selection-title">От основания до готовой поверхности</h2>
      <p class="finishing-system__lead">Материалы для каждого этапа — от подготовки основания до финишного окрашивания.</p>
      <a class="finishing-system__skip" href="#production" data-stage-jump><span data-stage-exit-label>Пропустить этапы</span> <span aria-hidden="true">↓</span></a>
    </header>

    <div class="finishing-system__layout">
      <ol class="finishing-system__steps" aria-label="Этапы отделки">
        {finishingStages.map((stage, index) => (
          <li class="finishing-system__step" data-finishing-step data-active={String(index === 0)}>
            <article id={`finishing-${stage.id}`} aria-labelledby={`finishing-title-${stage.id}`} tabindex="-1">
              <div class="finishing-system__step-heading">
                <span class="finishing-system__number" aria-hidden="true">{stage.number}</span>
                <h3 id={`finishing-title-${stage.id}`}>{stage.title}</h3>
              </div>
              <div class="finishing-system__inline-visual" data-motion-reveal="visual"><FinishingStageVisual stage={stage} /></div>
              <p class="finishing-system__description">{stage.description}</p>
              <div class="finishing-system__links" aria-label={stage.category}>
                {stage.links.map((link, linkIndex) => (
                  <>
                    {linkIndex > 0 && <span aria-hidden="true">и</span>}
                    <a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>
                  </>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>

      <aside class="finishing-system__visual-column" aria-label="Визуалы и навигация по этапам">
        <div class="finishing-system__sticky">
          <div class="finishing-system__scene">
            {finishingStages.map((stage, index) => (
              <div class="finishing-system__panel" data-finishing-panel data-active={String(index === 0)} aria-hidden={index !== 0}>
                <FinishingStageVisual stage={stage} />
              </div>
            ))}
          </div>
          <div class="finishing-system__controls">
            <nav class="finishing-system__nav" aria-label="Перейти к этапу отделки">
              {finishingStages.map((stage, index) => (
                <a href={`#finishing-${stage.id}`} aria-label={`${stage.number} — ${stage.title}`} aria-current={index === 0 ? 'step' : undefined} data-stage-jump data-stage-nav>{stage.number}</a>
              ))}
            </nav>
            <a class="finishing-system__skip" href="#production" data-stage-jump><span data-stage-exit-label>Пропустить этапы</span> <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </aside>
    </div>

    <p class="finishing-system__note">Состав этапов зависит от основания и выбранной системы отделки. Конкретную схему применения сверяйте с технической документацией материалов.</p>
  </div>
</section>

<script>
  import { initFinishingSystems } from '../scripts/finishing-system';
  initFinishingSystems();
</script>

<style>
  .finishing-system {
    --finishing-navy: #102336;
    --finishing-accent: #55151b;
    --finishing-header: var(--site-header-height, 76px);
    --finishing-scene-height: min(480px, calc(100svh - var(--finishing-header) - 152px));
    padding-top: 80px;
    /* Combined with production's existing top padding: about 123px from the last text line. */
    padding-bottom: 36px;
    background: var(--site-paper, #f8f8f5);
    color: var(--finishing-navy);
    font-family: 'PROMIX Hero Manrope', Arial, sans-serif;
    border-top: 1px solid #d6dbdb;
  }
  .finishing-system__container {
    width: min(var(--site-content-max), calc(100% - var(--site-content-gutter) * 2));
    margin-inline: auto;
  }
  .finishing-system .finishing-system__eyebrow {
    font-size: 12px; line-height: 1.5; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase;
  }
  .finishing-system .finishing-system__intro h2 {
    max-width: 980px; margin-top: 22px;
    font-size: clamp(44px, 3.8vw, 56px); font-weight: 500;
    line-height: 1.14; letter-spacing: -.045em; text-wrap: balance;
  }
  .finishing-system .finishing-system__lead {
    max-width: 650px; margin-top: 24px; font-size: 18px; line-height: 1.65;
  }
  .finishing-system__intro > .finishing-system__skip { margin-top: 16px; }
  .finishing-system__layout { margin-top: 48px; }
  .finishing-system__steps { list-style: none; margin: 0; padding: 0; }
  .finishing-system__step + .finishing-system__step { margin-top: 48px; }
  .finishing-system__step article { scroll-margin-top: 32px; }
  .finishing-system__step-heading { margin-bottom: 24px; }
  .finishing-system__number {
    display: block; margin-bottom: 20px; font-size: 76px; font-weight: 400;
    line-height: 1; letter-spacing: -.065em; font-variant-numeric: tabular-nums;
  }
  .finishing-system__step[data-active='true'] .finishing-system__number { color: var(--finishing-accent); }
  .finishing-system .finishing-system__step h3 {
    font-size: clamp(28px, 2.3vw, 34px); line-height: 1.2;
    font-weight: 500; letter-spacing: -.04em;
  }
  .finishing-system .finishing-system__description {
    max-width: 430px; margin-top: 24px; font-size: 17px; line-height: 1.65;
  }
  .finishing-system__links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 16px; }
  .finishing-system__links a {
    display: inline-flex; align-items: center; gap: 16px;
    min-height: 44px; padding-block: 8px;
    border-bottom: 1px solid #87929b; font-size: 16px; line-height: 1.5;
  }
  @media (hover: hover) and (pointer: fine) {
  .finishing-system__links a:hover { border-color: currentColor; }
}
  .finishing-system__visual-column { display: none; }
  .finishing-system__scene { height: var(--finishing-scene-height); position: relative; background: #e7e8e3; }
  .finishing-system__panel {
    position: absolute; inset: 0; opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity var(--motion-medium) var(--ease-standard), visibility 0s linear var(--motion-medium);
  }
  .finishing-system__panel[data-active='true'] { opacity: 1; visibility: visible; transition-delay: 0s; }
  /* Images crossfade; an outgoing placeholder caption disappears immediately. */
  .finishing-system__panel[data-active='false'] :global(figcaption) { visibility: hidden; }
  .finishing-system__controls { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; margin-top: 16px; }
  .finishing-system__nav { display: flex; gap: 6px; }
  .finishing-system__nav a {
    display: grid; place-items: center; min-width: 44px; min-height: 48px;
    border-bottom: 2px solid #b7bfc2; font-size: 16px; font-variant-numeric: tabular-nums;
  }
  .finishing-system .finishing-system__nav a[aria-current='step'] { color: var(--finishing-accent); border-bottom: 2px solid currentColor; }
  @media (hover: hover) and (pointer: fine) {
  .finishing-system__nav a:hover { background: #eeefeb; }
}
  .finishing-system__skip { display: inline-flex; align-items: center; min-height: 44px; gap: 14px; font-size: 16px; }
  @media (hover: hover) and (pointer: fine) {
  .finishing-system__skip:hover { text-decoration: underline; text-underline-offset: 5px; }
}
  .finishing-system :is(a, article):focus-visible { outline: 2px solid var(--finishing-navy); outline-offset: 5px; }
  .finishing-system .finishing-system__note { max-width: 780px; margin-top: 40px; font-size: 16px; line-height: 1.65; color: #53616b; }

  /* Low desktop windows and the non-scripted page use short illustrated rows. */
  @media (min-width: 1101px) {
    .finishing-system__step + .finishing-system__step { margin-top: 28px; }
    .finishing-system__step article { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 40px; }
    .finishing-system__inline-visual { grid-column: 2; grid-row: 1 / span 3; height: 220px; }
    .finishing-system__step-heading { display: flex; align-items: baseline; gap: 20px; margin-bottom: 16px; }
    .finishing-system__number { margin: 0; font-size: 44px; }
    .finishing-system .finishing-system__step h3 { font-size: 28px; }
    .finishing-system .finishing-system__description { margin-top: 0; }
  }

  /* Keep every step in the document; the sticky illustration follows reading
     without adding viewport-sized gaps between the short descriptions. */
  @media (min-width: 1101px) and (min-height: 720px) {
    .finishing-system[data-enhanced] .finishing-system__layout { display: grid; grid-template-columns: minmax(0, 39fr) minmax(0, 61fr); gap: 48px; }
    .finishing-system[data-enhanced] .finishing-system__inline-visual { display: none; }
    .finishing-system[data-enhanced] .finishing-system__visual-column { display: block; min-width: 0; }
    .finishing-system__sticky { position: sticky; top: calc(var(--finishing-header) + 24px); }
    .finishing-system[data-enhanced] .finishing-system__step {
      margin: 0; padding: 24px 0 28px;
      border-top: 1px solid #d6dbdb;
    }
    .finishing-system[data-enhanced] .finishing-system__step article { display: block; }
    .finishing-system[data-enhanced] .finishing-system__intro > .finishing-system__skip { display: none; }
    .finishing-system[data-enhanced] .finishing-system__description { margin-top: 0; }
  }
  @media (max-width: 1100px) {
    .finishing-system { padding-top: 64px; }
    .finishing-system__layout { max-width: 760px; }
    .finishing-system__step-heading { display: flex; align-items: center; gap: 24px; }
    .finishing-system__number { margin: 0; flex-shrink: 0; font-size: 64px; }
  }
  @media (max-width: 760px) {
    .finishing-system { padding-top: 40px; padding-bottom: 24px; }
    .finishing-system .finishing-system__intro h2 { font-size: 36px; text-wrap: initial; }
    .finishing-system .finishing-system__lead { font-size: 16px; }
    .finishing-system__intro > .finishing-system__skip { margin-top: 8px; }
    .finishing-system__layout { margin-top: 16px; }
    .finishing-system__step-heading { gap: 20px; }
    .finishing-system .finishing-system__step h3 { font-size: 28px; }
    .finishing-system .finishing-system__description { font-size: 16px; }
    .finishing-system__links { gap: 8px 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .finishing-system__panel { transition: none; }
  }
</style>
