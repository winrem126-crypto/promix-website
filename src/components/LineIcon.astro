---
import type { LineIconName } from '../data/line-icons';

interface Props {
  name: LineIconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg class:list={['line-icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'grid' && <><rect x="3.5" y="3.5" width="6.5" height="6.5"/><rect x="14" y="3.5" width="6.5" height="6.5"/><rect x="3.5" y="14" width="6.5" height="6.5"/><rect x="14" y="14" width="6.5" height="6.5"/></>}
  {name === 'trowel' && <><path d="M3.5 16.5 16 8.2l4.5 1.7-8.1 8.2Z"/><path d="m12.8 10.3-2.1-3.1 2.5-1.7 2.1 3.1"/></>}
  {name === 'primer' && <><path d="M6.2 5.2h11.6l1.4 14.2H4.8Z"/><path d="M8.6 5.2V3.6h6.8v1.6"/><path d="M8.2 13.6h7.6"/></>}
  {name === 'paint' && <><path d="M4.2 7.2h12.4v5.3H4.2z"/><path d="M16.6 9.8h2.1a1.5 1.5 0 0 1 1.5 1.5v1.3a1.5 1.5 0 0 1-1.5 1.5h-6.6"/><path d="M12.1 12.5v7.8"/></>}
  {name === 'adhesive' && <><path d="m5 18.5 8.5-8.5 4.5 4.5-8.5 4.2Z"/><path d="m13.5 10 2-2 4.5 4.5-2 2"/><path d="M6.8 16.7 4 19.5"/></>}
  {name === 'drop' && <path d="M12 3.3c3.2 4.1 6 7.2 6 10.5a6 6 0 0 1-12 0c0-3.3 2.8-6.4 6-10.5Z"/>}
  {name === 'roll' && <><rect x="6" y="3.4" width="12" height="17.2" rx="3"/><path d="M9.3 3.4v17.2M14.7 3.4v17.2"/></>}
  {name === 'purpose' && <><circle cx="12" cy="12" r="7.8"/><circle cx="12" cy="12" r="3.4"/><path d="M12 2.5v3.2M21.5 12h-3.2M12 21.5v-3.2M2.5 12h3.2"/></>}
  {name === 'application' && <><path d="M4 6.5h10v4H4z"/><path d="M14 8.5h3a2 2 0 0 1 2 2v1.7h-7v8.3"/></>}
  {name === 'layers' && <><path d="m4 8 8-4 8 4-8 4Z"/><path d="m4 12 8 4 8-4M4 16l8 4 8-4"/></>}
  {name === 'coverage' && <><path d="M4 4h16v16H4z"/><path d="m7 17 10-10M7 11l4-4M13 17l4-4"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.2 2"/></>}
  {name === 'package' && <><path d="m4.5 7.2 7.5-4 7.5 4v9.6l-7.5 4-7.5-4Z"/><path d="m4.5 7.2 7.5 4 7.5-4M12 11.2v9.6"/></>}
  {name === 'grain' && <><circle cx="7" cy="8" r="1.2"/><circle cx="13.2" cy="6" r="1.2"/><circle cx="17.5" cy="11" r="1.2"/><circle cx="9.5" cy="14" r="1.2"/><circle cx="15" cy="17.5" r="1.2"/></>}
  {name === 'size' && <><path d="M5 7V4h3M19 7V4h-3M5 17v3h3M19 17v3h-3"/><path d="M8 12h8M8 12l2-2M8 12l2 2M16 12l-2-2M16 12l-2 2"/></>}
</svg>
