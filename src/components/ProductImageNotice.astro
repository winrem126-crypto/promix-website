---
import type { Product } from '../data/products';
interface Props { product: Product; compact?: boolean; }
const { product, compact = false } = Astro.props;
---

<div class:list={['product-image-notice', { 'product-image-notice--card': compact }]}>
  <span class="product-image-notice__category">{product.categoryLabel}</span>
  <strong>{product.name}</strong>
  <span class="product-image-notice__subtitle">{product.subtitle}</span>
</div>

<style>
  .product-image-notice {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(24px, 4vw, 56px);
    background: linear-gradient(135deg, #f5f2ed, #e7e0d6);
    color: #102336;
    text-align: left;
  }
  .product-image-notice__category { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .product-image-notice strong { max-width: 100%; font-size: clamp(28px, 3vw, 48px); font-weight: 500; line-height: 1.1; letter-spacing: -.04em; }
  .product-image-notice__subtitle { max-width: 28ch; padding-top: 18px; border-top: 1px solid #87929a; font-size: 14px; line-height: 1.5; }
  .product-image-notice--card { container-type: inline-size; gap: 12px; padding: 16px; }
  .product-image-notice--card .product-image-notice__category { font-size: clamp(10px, 4cqw, 12px); line-height: 1.4; }
  .product-image-notice--card strong { font-size: clamp(18px, 9cqw, 28px); }
  .product-image-notice--card .product-image-notice__subtitle { max-width: 100%; padding-top: 8px; font-size: clamp(11px, 4cqw, 14px); line-height: 1.4; }
</style>
