# SMTP настройки для серверного API. Пароль и реальные доступы хранить отдельно.
# Сборка статического Astro не требует этих переменных.
# Текущий PHP читает getenv() через приватный backend/config/config.php;
# корневой .env автоматически не загружается.
SMTP_HOST=
SMTP_PORT=
# smtps/ssl/true = SMTPS; starttls/tls = STARTTLS. Сверить с SMTP-провайдером.
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASSWORD=

# Реальные имена переменных, которые уже читает текущий PHP backend.
LEADS_FROM_EMAIL=
LEADS_TO_EMAIL=simkraski@mail.ru

# Секрет должен быть случайным, не менее 32 байт. Не копировать example как готовую настройку.
LEADS_STORAGE_SECRET=
# Приватный локальный каталог, общий для PHP workers; вне public/ и dist/.
LEADS_STORAGE_PATH=
LEADS_RATE_WINDOW_SECONDS=900
LEADS_RATE_CLIENT_LIMIT=5
LEADS_RATE_GLOBAL_LIMIT=100
LEADS_IDEMPOTENCY_TTL_SECONDS=86400
# Точные IP доверенных прокси через запятую. Пусто = использовать только REMOTE_ADDR.
# Прокси должен перезаписывать X-Forwarded-For одним IP, не добавлять цепочку.
LEADS_TRUSTED_PROXIES=
SMTP_TIMEOUT_SECONDS=8
