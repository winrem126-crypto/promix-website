# EXAMPLE: include inside the existing canonical HTTPS server {} block.
# Exact reviewed URL mappings; query string is preserved; unmatched paths retain real 404.
# Install as /etc/nginx/snippets/promix-redirects.conf only after reviewing OLD_NEW_URL_MAP.md.
# No wildcard product remapping. Pending legacy pages are deliberately absent.

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /post-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /page-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /products-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /post-archive-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /category-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /product_category-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Старая XML карта заменяется фактическим новым sitemap index без выдачи HTML
location = /product_tags-sitemap.xml { return 301 "/sitemap-index.xml$is_args$args"; }

# Политика конфиденциальности; семантическое назначение совпадает, юридический текст проверяет компания
location = /privacy-policy/ { return 301 "/privacy/$is_args$args"; }
location = /privacy-policy { return 301 "/privacy/$is_args$args"; }

# Контакты перенесены в существующий раздел главной
location = /contacts/ { return 301 "/$is_args$args#contacts"; }
location = /contacts { return 301 "/$is_args$args#contacts"; }

# Производство перенесено в существующий раздел главной
location = /production/ { return 301 "/$is_args$args#production"; }
location = /production { return 301 "/$is_args$args#production"; }

# Старое предложение будущим дилерам ведёт в существующее партнёрство; обещания скидок не переносятся
location = /dealer/ { return 301 "/$is_args$args#partners"; }
location = /dealer { return 301 "/$is_args$args#partners"; }

# Общий каталог продукции
location = /katalog-produkczii/ { return 301 "/products/$is_args$args"; }
location = /katalog-produkczii { return 301 "/products/$is_args$args"; }

